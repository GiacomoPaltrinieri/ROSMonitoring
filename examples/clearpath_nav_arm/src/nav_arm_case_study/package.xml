<?xml version="1.0"?>
<package format="3">
  <name>nav_arm_case_study</name>
  <version>0.1.0</version>
  <description>Clearpath A200 Nav2/MoveIt interlock case study for ROSMonitoring.</description>
  <maintainer email="giaco.paltri@example.com">Giacomo</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>action_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>clearpath_gz</exec_depend>
  <exec_depend>clearpath_manipulators</exec_depend>
  <exec_depend>clearpath_nav2_demos</exec_depend>
  <exec_depend>kortex_description</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
